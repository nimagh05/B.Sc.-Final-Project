{
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=docsearch;Username=postgres;Password=CHANGE_ME"
  },
  "Ai": {
    "Embedding": {
      "Provider": "Ollama",
      "Model": "bge-m3",
      "Endpoint": "http://127.0.0.1:11434",
      "ApiKey": null,
      "Dimensions": 1024,
      "QueryPrefix": "",
      "PassagePrefix": "",
      "BatchSize": 4,
      "NumThread": 3,
      "KeepAlive": "5m",
      "Truncate": false,
      "PauseBetweenBatchesMs": 0,
      "TimeoutSeconds": 120
    },
    "Chat": {
      "Provider": "OpenAICompatible",
      "Model": "gemini-3.5-flash-lite",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "ApiKey": null,
      "TimeoutSeconds": 60,
      "Temperature": 0.1,
      "MaxOutputTokens": 1024
    }
  },
  "Rag": {
    "TopK": 6,
    "CandidateK": 30,
    "MinSimilarity": 0.55,
    "MaxContextTokens": 4000,
    "UseHybrid": true,
    "RrfK": 60,
    "ReturnSourcesWhenNotFound": false,
    "PromptVersion": "v1"
  },
  "Chunking": {
    "TargetTokens": 425,
    "MaxTokens": 500,
    "MinTokens": 80,
    "OverlapRatio": 0.15,
    "RespectLegalStructure": true,
    "IncludeSectionTitleInEmbedding": true,
    "PersianMultiplier": 1.45,
    "LatinMultiplier": 2.25,
    "SymbolsPerToken": 12
  },
  "Extraction": {
    "Provider": "Sidecar",
    "ExtractorBaseUrl": "http://127.0.0.1:8000",
    "OcrEnabled": false,
    "OcrDpi": 250,
    "MinPageQuality": 0.35
  },
  "Storage": {
    "RootPath": "./data/files",
    "MaxUploadMb": 50
  },
  "Ingestion": {
    "MaxConcurrentDocuments": 1,
    "QueueCapacity": 100
  },
  "Auth": {
    "AllowSelfRegistration": true,
    "BootstrapAdmin": {
      "Email": null,
      "Password": null
    }
  },
  "Jwt": {
    "Issuer": "docsearch",
    "Audience": "docsearch",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Docs": {
    "Enabled": true
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "AuthIpPermitLimit": 100,
    "AuthWindowMinutes": 1,
    "AskPermitLimit": 30,
    "AskWindowMinutes": 1,
    "UploadPermitLimit": 20,
    "UploadWindowHours": 1
  },
  "Network": {
    "TrustedProxyCidrs": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/docsearch-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
