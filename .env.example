# --- Docker Compose identity (change per copy of the repo to avoid clashes) ---
COMPOSE_PROJECT_NAME=docsearch

# --- Ports on the host ---
DB_PORT=5432
API_PORT=5000
WEB_PORT=5173
EXTRACTOR_PORT=8000

# --- Database (DB_HOST is used by scripts/load-env.ps1 for host `dotnet run` / `dotnet ef`) ---
DB_HOST=127.0.0.1
POSTGRES_DB=docsearch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_please

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
Jwt__SigningKey=change_me_to_a_random_string_of_at_least_32_chars
Auth__BootstrapAdmin__Email=admin@example.com
Auth__BootstrapAdmin__Password=Change_me_123!
Cors__AllowedOrigins__0=http://localhost:5173

# --- Extraction & Selective OCR (Docker Compose overrides ExtractorBaseUrl to http://extractor:8000) ---
Extraction__OcrMode=Defective
Extraction__ExtractorBaseUrl=http://127.0.0.1:8000

# --- AI Embedding (used by host `dotnet run`; Docker Compose defaults to http://host.docker.internal:11434 unless DOCKER_EMBEDDING_ENDPOINT is set) ---
Ai__Embedding__Provider=Ollama
Ai__Embedding__Model=bge-m3
Ai__Embedding__Endpoint=http://127.0.0.1:11434

# --- AI Chat (leave Ai__Chat__ApiKey empty here; set real key only in git-ignored .env or user-secrets) ---
Ai__Chat__Provider=OpenAICompatible
Ai__Chat__Endpoint=https://generativelanguage.googleapis.com/v1beta/openai/
Ai__Chat__Model=gemini-3.5-flash-lite
Ai__Chat__ApiKey=

# --- RAG ---
Rag__MinSimilarity=0.55
